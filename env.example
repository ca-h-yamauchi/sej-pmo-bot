# Slack設定
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# Googleスプレッドシート設定
SPREADSHEET_KEY=your-spreadsheet-key-here

# GCP設定
PROJECT_ID=your-gcp-project-id
# 3.x 世代 Flash-Lite は global エンドポイントを使用
LOCATION=global
# 使用する Gemini モデル（未指定時は gemini-3.5-flash-lite）
# 退役時や切り替え例: gemini-3.5-flash-lite, gemini-2.5-flash-lite
# GEMINI_MODEL=gemini-3.5-flash-lite

# 機能フラグ（オプション）
# メール正規表現フォールバックを無効化（デグレード時ロールバック）する場合は false を指定
# ENABLE_EMAIL_REGEX_FALLBACK=true

